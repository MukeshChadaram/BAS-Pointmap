@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix bldg: <urn:pointmap:LEGACY-MIX#> .

bldg:LEGACY-MIX a brick:Building ;
    rdfs:label "LEGACY-MIX" .

bldg:RTU-01 a brick:Rooftop_Unit ;
    rdfs:label "RTU-01" ;
    brick:hasLocation bldg:LEGACY-MIX .

bldg:AHU-01 a brick:Air_Handling_Unit ;
    rdfs:label "AHU-01" ;
    brick:hasLocation bldg:LEGACY-MIX .

bldg:VAV-2-01 a brick:Variable_Air_Volume_Box ;
    rdfs:label "VAV-2-01" ;
    brick:hasLocation bldg:LEGACY-MIX .

bldg:VAV-2-02 a brick:Variable_Air_Volume_Box ;
    rdfs:label "VAV-2-02" ;
    brick:hasLocation bldg:LEGACY-MIX .

bldg:VAV-2-03 a brick:Variable_Air_Volume_Box ;
    rdfs:label "VAV-2-03" ;
