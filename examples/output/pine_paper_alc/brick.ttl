bldg:RTU-01.DA-T a brick:Supply_Air_Temperature_Sensor ;
    rdfs:label "#pine_paper/rtu_1/da_temp" ;
    brick:isPointOf bldg:RTU-01 ;
    brick:hasUnit unit:DEG_C .

