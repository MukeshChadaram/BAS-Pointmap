@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix bldg: <urn:pointmap:PINE-PAPER#> .

bldg:PINE-PAPER a brick:Building ;
    rdfs:label "PINE-PAPER" .

bldg:RTU-01 a brick:Rooftop_Unit ;
    rdfs:label "RTU-01" ;
    brick:hasLocation bldg:PINE-PAPER .

bldg:RTU-02 a brick:Rooftop_Unit ;
    rdfs:label "RTU-02" ;
    brick:hasLocation bldg:PINE-PAPER .

bldg:RTU-03 a brick:Rooftop_Unit ;
    rdfs:label "RTU-03" ;
    brick:hasLocation bldg:PINE-PAPER .

bldg:UH-01 a brick:Space_Heater ;
